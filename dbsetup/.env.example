# .ENV VARS
#
# Usage:
#   cp .env.example .env
#   replace vars with correct values

# Auto-generate connect.php from DB_* variables on each container start
GENERATE_CONNECT_PHP=1

# Port mapping (default 8080)
SALDI_PORT=8080

# DBCONNECTION HAVE TO BE SET WHEN USING DOCKER
DB_TYPE=postgresql

DB_HOST=db
DB_NAME=dbname
DB_USER=dbuser
DB_PASSWORD=CHANGE_ME