# Saldi Docker Environment Configuration
# ========================================
#
# Usage:
#   1. Copy this file: cp .env.example .env
#   2. Edit .env with your actual values
#   3. Run: docker-compose up
#
# IMPORTANT: Never commit .env to git - it contains passwords!

# ----------------------------------------
# Docker Settings
# ----------------------------------------

# Auto-generate connect.php from DB_* variables on each container start
# Set to 0 if you want to manage connect.php manually
GENERATE_CONNECT_PHP=1

# Port to expose Saldi on (access via http://localhost:PORT)
SALDI_PORT=8080

# ----------------------------------------
# Database Connection
# ----------------------------------------

# Database type: "postgresql" or "mysqli"
DB_TYPE=postgresql

# Database hostname
# - Use "db" when using the included docker-compose database service
# - Use actual hostname/IP for external database
DB_HOST=db

# Database name
DB_NAME=saldidb

# Database credentials
DB_USER=user
DB_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
